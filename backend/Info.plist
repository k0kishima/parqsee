<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Merged into the bundle's Info.plist by Tauri (bundle.macOS.infoPlist
      in tauri.conf.json). Keys App Store Connect asks about that Tauri
      has no config for.

      The app makes no network requests and uses no encryption of its own,
      so it is exempt from export compliance; declaring it here answers
      the question App Store Connect would otherwise ask on every upload.
    -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!--
      The languages the app is available in. There are no .lproj folders
      to infer them from: the UI is localized in the webview (i18next over
      frontend/src/locales) and the native menu in Rust
      (services::menu_labels), so this key is the only place macOS can
      learn about Japanese.

      It decides more than the App Store listing. An app whose
      localizations macOS does not know is treated as English-only, so on
      a Japanese Mac the parts of the menu AppKit supplies itself — the
      Services submenu, the Help menu's search field, Emoji & Symbols —
      would stay in English next to our Japanese items, and
      `navigator.language` in the webview would read `en`, which is what
      picks the language on a first launch (`systemLanguage` in
      lib/settings-storage.ts). Declaring both also puts Parqsee in
      System Settings › General › Language & Region › Applications.
    -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ja</string>
    </array>
</dict>
</plist>
