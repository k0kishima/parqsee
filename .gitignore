# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
node_modules

# QA fixtures generated by scripts/qa/gen_*.py
scripts/qa/fixtures/

# Per-developer Claude Code state. Anything shared (CLAUDE.md, skills,
# a project settings.json) is committed deliberately; these are not.
.claude/settings.local.json
.claude/.credentials.json

# Provisioning profiles (Mac App Store / development) stay outside the
# repository; scripts/release/appstore.sh and scripts/qa/sign_for_storekit.sh
# take their path as an argument.
*.provisionprofile
