+#[cfg(test)]
+mod audit_diagnostics {
+    use super::*;
+    #[tokio::test]
+    async fn audit_late_init_does_not_notify() {
+        let license = Arc::new(License::new(Box::new(AlwaysUnlocked)));
+        let changes = Arc::new(Mutex::new(Vec::new()));
+        let seen = changes.clone();
+        license.set_on_change(Box::new(move |s| seen.lock().unwrap().push(s)));
+        let first = license.status().await;
+        assert_eq!(first.state, crate::models::IapState::Free);
+        assert!(first.store_error.unwrap().contains("did not answer in time"));
+        license.init().await;
+        assert_eq!(license.status().await.state, crate::models::IapState::Unlocked);
+        assert!(changes.lock().unwrap().is_empty());
+        println!("AUDIT: timeout Free -> backend Unlocked; zero UI notifications");
+    }
+}
