+#[cfg(test)]
+mod audit_diagnostics {
+    use super::*;
+    use crate::services::access::fake::FakeBookmarks;
+    #[tokio::test]
+    async fn audit_failed_open_retains_grant() {
+        let path = crate::services::test_support::temp_path("audit", "broken.parquet");
+        std::fs::write(&path, b"broken parquet").unwrap();
+        let path = path.to_string_lossy().into_owned();
+        let fake = FakeBookmarks::default();
+        let access = Arc::new(FileAccess::load(Box::new(fake.clone()), None));
+        access.remember_file(&path).unwrap();
+        access.release(&path);
+        let cache = ParquetCache::with_access(access);
+        assert!(cache.get_or_create_metadata(&path).await.is_err());
+        assert!(cache.metadata.lock().unwrap().is_empty());
+        assert!(cache.sessions.lock().unwrap().is_empty());
+        assert_eq!(fake.active(), vec![path.clone()]);
+        println!("AUDIT: failed metadata, zero cache entries, one held grant");
+        cache.evict(&path).await.unwrap();
+        assert!(fake.active().is_empty());
+    }
+}
